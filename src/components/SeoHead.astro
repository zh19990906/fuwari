---
import { profileConfig, siteConfig } from "@/config";
import { url } from "@utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	socialImage?: string;
	published?: Date;
	updated?: Date;
	isArticle?: boolean;
}

const {
	title,
	description,
	lang,
	socialImage = "/og-default.png",
	published,
	updated,
	isArticle = false,
} = Astro.props;

const pageTitle = title
	? `${title} - ${siteConfig.title}`
	: `${siteConfig.title} - ${siteConfig.subtitle}`;
const pageDescription = description || siteConfig.subtitle || pageTitle;
const siteRoot = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteRoot);
canonicalUrl.search = "";
canonicalUrl.hash = "";

function absoluteAssetUrl(value: string): string {
	if (/^https?:\/\//i.test(value)) return value;
	const path = value.startsWith("/") ? value : `/${value}`;
	return new URL(url(path), siteRoot).toString();
}

const socialImageUrl = absoluteAssetUrl(socialImage);
const rssUrl = new URL(url("/rss.xml"), siteRoot).toString();
const language = (lang || siteConfig.lang).replace("_", "-");
const publishedIso = published?.toISOString();
const updatedIso = updated?.toISOString();

const structuredData = isArticle
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			mainEntityOfPage: canonicalUrl.toString(),
			headline: title || siteConfig.title,
			description: pageDescription,
			inLanguage: language,
			image: [socialImageUrl],
			datePublished: publishedIso,
			dateModified: updatedIso || publishedIso,
			author: {
				"@type": "Person",
				name: profileConfig.name,
				url: "https://github.com/zh19990906",
			},
			publisher: {
				"@type": "Person",
				name: profileConfig.name,
			},
		}
	: {
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: siteConfig.title,
			description: pageDescription,
			url: canonicalUrl.toString(),
			inLanguage: language,
			author: {
				"@type": "Person",
				name: profileConfig.name,
				url: "https://github.com/zh19990906",
			},
		};
---

<link rel="canonical" href={canonicalUrl.toString()} />
<link rel="apple-touch-icon" sizes="180x180" href={url("/apple-touch-icon.png")} />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={rssUrl} />
<meta property="og:url" content={canonicalUrl.toString()} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:url" content={canonicalUrl.toString()} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={socialImageUrl} />
{publishedIso && <meta property="article:published_time" content={publishedIso} />}
{updatedIso && <meta property="article:modified_time" content={updatedIso} />}
{isArticle && <meta property="article:author" content={profileConfig.name} />}
<script
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
></script>
