---
import I18nKey from "../i18n/i18nKey";
import { zh_CN } from "../i18n/languages/zh_CN";
---

<div
	class="mx-1 flex h-9 items-center rounded-lg bg-black/[0.04] px-1 text-xs font-bold dark:bg-white/5"
	role="group"
	aria-label={zh_CN[I18nKey.language]}
	data-i18n-aria-label={I18nKey.language}
>
	<button
		type="button"
		class="language-option rounded-md px-2 py-1 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
		data-ui-language-option="zh_CN"
		data-active="true"
		aria-pressed="true"
		aria-label={zh_CN[I18nKey.switchToChinese]}
		data-i18n-aria-label={I18nKey.switchToChinese}
	>
		中
	</button>
	<span class="text-black/20 dark:text-white/20" aria-hidden="true">/</span>
	<button
		type="button"
		class="language-option rounded-md px-2 py-1 transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]"
		data-ui-language-option="en"
		data-active="false"
		aria-pressed="false"
		aria-label={zh_CN[I18nKey.switchToEnglish]}
		data-i18n-aria-label={I18nKey.switchToEnglish}
	>
		EN
	</button>
</div>

<style>
	.language-option {
		color: color-mix(in oklch, currentColor 50%, transparent);
	}
	.language-option:hover,
	.language-option[data-active="true"] {
		color: var(--primary);
		background: var(--btn-plain-bg-hover);
	}
</style>
