---
import { UiLabelKey, uiLanguageLabels } from "@i18n/ui-language-labels";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getActivitySummary } from "@utils/activity-utils";
import { Icon } from "astro-icon/components";

const summary = await getActivitySummary();
const recentCommits = summary.commits.slice(0, 10);
const groupedCommits = recentCommits.reduce<
	Record<string, typeof recentCommits>
>((groups, commit) => {
	const commits = groups[commit.dateKey] || [];
	commits.push(commit);
	groups[commit.dateKey] = commits;
	return groups;
}, {});

const timelineGroups = Object.entries(groupedCommits);
const maxHeatmapCount = Math.max(1, ...summary.heatmap.map((day) => day.count));

function heatmapClass(count: number): string {
	if (count === 0) return "bg-black/5 dark:bg-white/10";
	const ratio = count / maxHeatmapCount;
	if (ratio <= 0.25) return "bg-[var(--primary)]/20";
	if (ratio <= 0.5) return "bg-[var(--primary)]/40";
	if (ratio <= 0.75) return "bg-[var(--primary)]/65";
	return "bg-[var(--primary)]";
}

function formatShanghaiTime(value: string): string {
	return new Intl.DateTimeFormat("zh-CN", {
		timeZone: summary.timezone,
		hour: "2-digit",
		minute: "2-digit",
		hour12: false,
	}).format(new Date(value));
}

function kindLabel(kind: string): string {
	return (
		{
			content: "内容",
			feature: "功能",
			fix: "修复",
			docs: "文档",
			test: "测试",
			chore: "维护",
			release: "上线",
			other: "记录",
		}[kind] || "记录"
	);
}
---

<MainGridLayout
	title={uiLanguageLabels.zh_CN[UiLabelKey.activity]}
	titleKey={UiLabelKey.activity}
	description={uiLanguageLabels.zh_CN[UiLabelKey.activityIntro]}
>
	<div class="card-base px-6 md:px-8 py-7 mb-4">
		<div class="flex items-center gap-3 mb-3">
			<Icon name="material-symbols:history-rounded" class="text-3xl text-[var(--primary)]" />
			<h1 class="text-2xl font-bold" data-i18n-key={UiLabelKey.developmentActivity}>
				{uiLanguageLabels.zh_CN[UiLabelKey.developmentActivity]}
			</h1>
		</div>
		<p class="text-50 leading-7 mb-6" data-i18n-key={UiLabelKey.activityIntro}>
			{uiLanguageLabels.zh_CN[UiLabelKey.activityIntro]}
		</p>

		{summary.available ? (
			<>
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
					<div class="rounded-2xl bg-black/5 dark:bg-white/5 p-4">
						<div class="text-3xl font-bold text-90">{summary.todayCommits}</div>
						<div class="mt-1 text-sm text-50" data-i18n-key={UiLabelKey.todayCommits}>
							{uiLanguageLabels.zh_CN[UiLabelKey.todayCommits]}
						</div>
					</div>
					<div class="rounded-2xl bg-black/5 dark:bg-white/5 p-4">
						<div class="text-3xl font-bold text-90">{summary.todayReleases}</div>
						<div class="mt-1 text-sm text-50" data-i18n-key={UiLabelKey.todayReleases}>
							{uiLanguageLabels.zh_CN[UiLabelKey.todayReleases]}
						</div>
					</div>
					<div class="rounded-2xl bg-black/5 dark:bg-white/5 p-4">
						<div class="text-3xl font-bold text-90">{summary.last7DaysCommits}</div>
						<div class="mt-1 text-sm text-50" data-i18n-key={UiLabelKey.last7Days}>
							{uiLanguageLabels.zh_CN[UiLabelKey.last7Days]}
						</div>
					</div>
					<div class="rounded-2xl bg-black/5 dark:bg-white/5 p-4">
						<div class="text-lg font-bold text-90 break-words">
							{summary.lastUpdatedAt
								? new Intl.DateTimeFormat("zh-CN", {
										timeZone: summary.timezone,
										month: "2-digit",
										day: "2-digit",
										hour: "2-digit",
										minute: "2-digit",
										hour12: false,
									}).format(new Date(summary.lastUpdatedAt))
								: "—"}
						</div>
						<div class="mt-1 text-sm text-50" data-i18n-key={UiLabelKey.lastUpdated}>
							{uiLanguageLabels.zh_CN[UiLabelKey.lastUpdated]}
						</div>
					</div>
				</div>

				<section class="mb-8" aria-labelledby="activity-heatmap-title">
					<h2 id="activity-heatmap-title" class="text-xl font-bold mb-4" data-i18n-key={UiLabelKey.activityHeatmap}>
						{uiLanguageLabels.zh_CN[UiLabelKey.activityHeatmap]}
					</h2>
					<div class="grid grid-cols-[repeat(15,minmax(0,1fr))] sm:grid-cols-[repeat(30,minmax(0,1fr))] gap-1" role="img" aria-label="90 day commit heatmap">
						{summary.heatmap.map((day) => (
							<div
								class:list={["aspect-square rounded-[0.2rem] transition", heatmapClass(day.count)]}
								title={`${day.date}: ${day.count}`}
								aria-label={`${day.date}: ${day.count} commits`}
							></div>
						))}
					</div>
				</section>

				<section aria-labelledby="activity-timeline-title">
					<h2 id="activity-timeline-title" class="text-xl font-bold mb-4" data-i18n-key={UiLabelKey.activityTimeline}>
						{uiLanguageLabels.zh_CN[UiLabelKey.activityTimeline]}
					</h2>
					<div class="space-y-6">
						{timelineGroups.map(([date, commits]) => (
							<div>
								<h3 class="font-bold text-75 mb-2">{date}</h3>
								<div class="space-y-2">
									{commits.map((commit) => (
										<a
											href={`https://github.com/zh19990906/fuwari/commit/${commit.hash}`}
											target="_blank"
											rel="noopener"
											class:list={[
												"btn-card rounded-xl px-4 py-3 grid grid-cols-[4rem_minmax(0,1fr)] sm:grid-cols-[4rem_5rem_minmax(0,1fr)_4.5rem] gap-x-3 gap-y-2 items-center w-full !justify-stretch text-left",
												{ "opacity-65": commit.kind === "chore" || commit.kind === "test" },
											]}
										>
											<span data-activity-time class="text-xs text-40 tabular-nums justify-self-start">
												{formatShanghaiTime(commit.committedAt)}
											</span>
											<span data-activity-kind class="hidden sm:inline-flex justify-self-start rounded-full px-2 py-1 text-xs bg-[var(--primary)]/10 text-[var(--primary)]">
												{kindLabel(commit.kind)}
											</span>
											<span data-activity-title class="text-sm text-75 min-w-0 break-words justify-self-stretch text-left">
												{commit.displayTitle}
											</span>
											<code data-activity-hash class="hidden sm:block text-xs text-40 tabular-nums justify-self-end text-right">
												{commit.hash.slice(0, 7)}
											</code>
										</a>
									))}
								</div>
							</div>
						))}
					</div>
				</section>
			</>
		) : (
			<div class="rounded-2xl bg-black/5 dark:bg-white/5 p-6 text-50" data-i18n-key={UiLabelKey.activityUnavailable}>
				{uiLanguageLabels.zh_CN[UiLabelKey.activityUnavailable]}
			</div>
		)}
	</div>
</MainGridLayout>
