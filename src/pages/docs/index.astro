---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { UiLabelKey, uiLanguageLabels } from "../../i18n/ui-language-labels";
import { getDocsGroupSummaries } from "../../utils/docs-utils";
import { getDocsGroupUrl } from "../../utils/url-utils";

const groups = await getDocsGroupSummaries();
---

<MainGridLayout
    title={uiLanguageLabels.zh_CN[UiLabelKey.documentation]}
    titleKey={UiLabelKey.documentation}
    description={uiLanguageLabels.zh_CN[UiLabelKey.documentationIntro]}
>
    <div class="card-base px-6 md:px-8 py-7">
        <div class="flex items-center gap-3">
            <Icon name="material-symbols:menu-book-outline-rounded" class="text-3xl text-[var(--primary)]" />
            <h1 class="text-2xl font-bold" data-i18n-key={UiLabelKey.documentation}>
                {uiLanguageLabels.zh_CN[UiLabelKey.documentation]}
            </h1>
        </div>
        <p class="mt-3 mb-6 text-sm leading-6 text-50" data-i18n-key={UiLabelKey.documentationIntro}>
            {uiLanguageLabels.zh_CN[UiLabelKey.documentationIntro]}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-stretch">
            {groups.map(({ group, count }, index) => {
                const isOddFinalCard = groups.length % 2 === 1 && index === groups.length - 1;
                return (
                    <a
                        href={getDocsGroupUrl(group.slug)}
                        class:list={[
                            "btn-card rounded-2xl p-5 h-full grid grid-rows-[auto_1fr] active:scale-[0.98]",
                            {
                                "md:col-span-2 md:w-[calc(50%_-_0.5rem)] md:justify-self-center": isOddFinalCard,
                            },
                        ]}
                    >
                        <div class="flex items-start justify-between gap-4">
                            <h2 class="text-xl font-bold text-90">{group.title}</h2>
                            <span class="shrink-0 min-w-8 h-8 px-2 rounded-full bg-[var(--primary)] text-white text-sm font-bold flex items-center justify-center">
                                {count}
                            </span>
                        </div>
                        {group.description && <p data-doc-group-description class="mt-2 text-sm text-50 leading-6">{group.description}</p>}
                    </a>
                );
            })}
        </div>
    </div>
</MainGridLayout>
